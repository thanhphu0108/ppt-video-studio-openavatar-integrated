# Service never binds to LAN/Internet.  Invalid host values are forced back to 127.0.0.1.
VOICE_HOST=0.0.0.0
VOICE_PORT=8009

VOICE_ENGINE=f5-tts
DEFAULT_VOICE_ID=default
DEVICE=auto

# Leave empty to disable authentication.  If set, use Authorization: Bearer <value>.
LOCAL_API_KEY=

# Require the protected voice-upload password and rights confirmation for
# reference_audio sent to the API/UI.
REQUIRE_UPLOAD_PASSWORD=true

# Do not let the running service download model files by default.  Obtain a
# checkpoint intentionally during setup, cache it locally, then keep this false.
ALLOW_MODEL_DOWNLOAD=false

ENABLE_CACHE=true
OUTPUT_DIR=generated_audio
VOICE_DIR=voices
CACHE_DIR=cache
LOG_DIR=logs
TEMP_DIR=temp
MODEL_CACHE_DIR=models

MAX_CHARS_PER_CHUNK=350
SENTENCE_PAUSE_MS=180
PARAGRAPH_PAUSE_MS=350
NORMALIZE_NUMBERS=true

MIN_REFERENCE_SECONDS=2.0
MAX_REFERENCE_SECONDS=12.0
REFERENCE_SAMPLE_RATE=24000
OUTPUT_SAMPLE_RATE=24000

WAV2LIP_ENDPOINT=http://127.0.0.1:8008
LOG_FULL_TEXT=false
F5_MODEL=F5TTS_v1_Base
PRELOAD_MODEL=true
